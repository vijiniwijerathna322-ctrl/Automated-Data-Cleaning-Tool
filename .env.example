# Copy to .env and adjust. All variables are optional; defaults shown.

# --- API (datacleaner.api.settings) ---
DATACLEANER_MAX_UPLOAD_MB=25
DATACLEANER_MAX_ROWS=500000
DATACLEANER_LOG_LEVEL=INFO
DATACLEANER_CORS_ORIGINS=["http://localhost:8501"]

# --- UI ---
# Where the Streamlit UI finds the API
DATACLEANER_API_URL=http://localhost:8000
